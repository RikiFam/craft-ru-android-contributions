diff --git a/crates/ui-egui/src/i18n/tests.rs b/crates/ui-egui/src/i18n/tests.rs
index c9e3dc2f7c8c3b3c524912583d9908de680c653c..dc32769b2d899d637e52ce0a98f58df6e00c45c1 100644
--- a/crates/ui-egui/src/i18n/tests.rs
+++ b/crates/ui-egui/src/i18n/tests.rs
@@ -562,3 +562,19 @@ fn picker_lists_english_first_then_names_alphabetically() {
     assert!(pos("ru") < pos("ja"), "Cyrillic names come before CJK");
     assert_eq!(name_sort_key("Čeština"), "cestina");
 }
+
+#[test]
+fn russian_product_pages_have_no_english_fallbacks() {
+    for page in &artcraft_launcher_core::details::DETAILS {
+        let mut strings = vec![page.headline];
+        strings.extend(page.paragraphs());
+        for feature in page.features {
+            strings.extend([feature.title, feature.text]);
+        }
+        strings.extend(page.shots.iter().map(|shot| shot.caption));
+        for text in strings {
+            assert_ne!(tr(Lang::RU, text), text, "{}: {text}", page.id);
+            assert_eq!(tr(Lang::EN, text), text);
+        }
+    }
+}
