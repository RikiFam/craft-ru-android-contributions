+            wanted = false;
+        }
+        if focus_click && on_page {
+            wanted = true;
+        }
+        ui.ctx().data_mut(|d| d.insert_temp(id, wanted));
+        if app.canvas.focused && !wanted {
+            ui.ctx().output_mut(|o| o.ime = None);
+        }
+    }
